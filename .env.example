# Docker Compose Environment Variables
# Copy this file to .env and customize the values

# === Container Configuration ===

GITHUB_USERNAME=your_github_username

# Project name — must be unique per container to allow running multiple boxes simultaneously
COMPOSE_PROJECT_NAME=yolo-claudecode

# Container and hostname (required)
CONTAINER_NAME=yolo-claudecode

# Docker image name (optional, defaults to yoloimage)
DOCKER_IMAGE=yoloimage

# Host port to map to container SSH port 22 (optional, defaults to 22222)
HOST_PORT=22222

# Workspace path (optional, defaults to $HOME/workspace/$CONTAINER_NAME)
# WORKSPACE_PATH=/custom/path/to/workspace

# Set to false to skip installing pi-coding-agent and the anthropic-no-timeout extension
INSTALL_PI=true

# === Host user mapping ===
# UID/GID of your host user. Used twice: as USER_UID/USER_GID build args (the image
# creates the container user and its home with these IDs), and at startup to remap
# the user of a prebuilt image so files written to the mounted /workspace stay owned
# by your host user. If left unset, the build defaults to 1000 and the entrypoint
# auto-detects from the owner of the /workspace mount. To set explicitly, run:
#   echo "HOST_UID=$(id -u)" >> .env && echo "HOST_GID=$(id -g)" >> .env
# HOST_UID=1000
# HOST_GID=1000

# === LLM Configuration (Simplified) ===

# Single endpoint URL for your LLM server (vLLM, LM Studio, etc.)
# The container will auto-discover available models from {LLM_ENDPOINT}/v1/models
# Examples:
#   LLM_ENDPOINT=http://127.0.0.1:8001        # vLLM
#   LLM_ENDPOINT=http://host.docker.internal:11434  # Ollama (on host)
#
# If not set, a default placeholder config is created that you can edit manually.
LLM_ENDPOINT=http://127.0.0.1:8001

# API key for your LLM server (passed to the model provider). Leave empty for local servers.
# LLM_API_KEY=sk-...

# Transport for the generated pi provider (see README):
#   openai-completions   -> built-in, OpenAI-compatible servers (default)
#   anthropic-no-timeout -> Anthropic Messages endpoint w/ disabled body timeout (slow HW)
# LLM_API=openai-completions

# === Claude Code + local LLM (optional) ===

# When true, the entrypoint writes ~/.claude/settings.json so Claude Code talks to a local
# Anthropic Messages-compatible endpoint instead of the hosted API.
# CLAUDE_LOCAL_LLM=true
#
# Base URL / token default to LLM_ENDPOINT / LLM_API_KEY above; override here if Claude Code
# should use a different endpoint than pi. Base URL must NOT include /v1.
# CLAUDE_BASE_URL=http://127.0.0.1:8001
# CLAUDE_AUTH_TOKEN=sk-...
#
# Model for all Claude Code slots. If unset, auto-discovered from {base}/v1/models.
# CLAUDE_MODEL=my-model

# === Web search / fetch (pi-searxng extension) ===

# Endpoint of a SearXNG instance for the web_search tool (web_fetch needs no service).
# Run ONE shared SearXNG for all your boxes and point each at it. Port 9369 by convention.
# If unset, the extension defaults to http://localhost:9369.
#   SEARXNG_URL=http://searxng.lan:9369         # shared instance on your LAN
# SEARXNG_URL=http://host.docker.internal:9369  # SearXNG running on the container host
# SEARXNG_URL=

